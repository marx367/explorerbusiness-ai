# --- IA (opcional) ---
# Sin estas claves la app funciona igual con el motor determinístico + modo demo.
# Proveedor por defecto: Anthropic (Claude).
ANTHROPIC_API_KEY=TU_CLAVE_ACA
ANTHROPIC_MODEL=claude-sonnet-5-5

# Cualquier proveedor compatible con OpenAI (OpenRouter, OpenAI, DeepSeek, GLM, Qwen...).
# Se usa solo si no está configurado Anthropic.
OPENAI_COMPAT_BASE_URL=TU_URL_ACA
OPENAI_COMPAT_API_KEY=TU_CLAVE_ACA
OPENAI_COMPAT_MODEL=TU_MODELO_ACA

# --- Búsqueda de competidores (opcional) ---
# Sin esto, la sección "Competidores" muestra "no disponible".
TAVILY_API_KEY=TU_CLAVE_ACA
